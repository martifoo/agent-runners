#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
. "$ROOT/lib/agr.sh"

usage() {
  cat <<'EOF'
agr — coding agents in microsandbox microVMs

Usage:
  agr <claude|codex|pi|grok> [options] [agent-args...]
  agr build-base
  agr install
  agr uninstall [--purge]
  agr help

Options (before agent args):
  --rebuild-base   Rebuild the shared base snapshot, then run
  --offline        Do not contact registries; require agent already installed

Environment:
  CPUS / MEMORY         Sandbox size (default 2 / 2G)
  AGR_SNAPSHOT_NAME    Snapshot name (default agr-base)
  AGR_BASE_IMAGE       Image used to build base (default node:24-bookworm)
  AGR_CONFIG_DIR       Host config dir (default ~/.config/agr)

Host config (optional):
  ~/.config/agr/.env         Secrets (KEY=value). Keep chmod 600.
  ~/.config/agr/startup.sh   Optional shell setup sourced in the guest
  ~/.config/agr/manifest     source:destination lines copied into the guest
EOF
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help)
    usage
    ;;
  build-base)
    shift
    agr_build_base "$@"
    ;;
  install)
    shift
    "$ROOT/scripts/install.sh" "$@"
    ;;
  uninstall)
    shift
    "$ROOT/scripts/uninstall.sh" "$@"
    ;;
  claude|codex|pi|grok)
    shift
    agr_run "$cmd" "$@"
    ;;
  *)
    echo "agr: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
